#include <iostream>
#include <vector>
using namespace std;

int secondHighest(const vector<int>& scores) {
    int highest = -1;
    int second = -1;

    for (int score : scores) {
        if (score > highest) {
            second = highest;
            highest = score;
        } else if (score < highest && score > second) {
            second = score;
        }
    }

    return second;
}

int main() {
    vector<int> scores = {45, 78, 92, 78, 60};
    cout << secondHighest(scores) << '\n';  // 78

    vector<int> sameScores = {50, 50, 50};
    cout << secondHighest(sameScores) << '\n';  // -1

    return 0;
}
